# Copy this file to .env and fill in real values. Never commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_ENGINE=sqlite

# Local .env loading is enabled by default. Process variables always win.
# Production should set DJANGO_READ_DOT_ENV=False in its process environment.

# Production example: configure these in your deployment's environment/secret
# store instead of copying this local file. See docs/deployment.md first.
# DJANGO_READ_DOT_ENV=False
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=detailwise.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://detailwise.example.com
# DJANGO_DB_ENGINE=postgresql
# POSTGRES_DB=detailwise
# POSTGRES_USER=detailwise
# POSTGRES_PASSWORD=<set-a-secret-in-the-deployment-environment>
# POSTGRES_HOST=db.example.internal
# POSTGRES_PORT=5432
# DJANGO_DB_SSLMODE=verify-full
# DJANGO_DB_SSLROOTCERT=/run/secrets/postgresql-ca.pem
# DJANGO_DB_CONN_MAX_AGE=60
# DJANGO_DB_CONNECT_TIMEOUT=10

# These default to True when DEBUG=False, False when DEBUG=True.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True

# Keep HSTS off until HTTPS is verified. Only then consider a short initial
# duration, e.g. 300. Subdomains and preload need separate deployment decisions.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

# False by default. Enable only behind a verified trusted proxy that strips
# client-supplied X-Forwarded-Proto and prevents direct public app access.
# The recommended Waitress proxy configuration does not need this flag.
# DJANGO_TRUST_X_FORWARDED_PROTO=False

# Optional: local AI explanations through Ollama. No API key is needed.
# Leave these commented out to use the defaults shown.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3
# GUIDANCE_LLM_TIMEOUT=45
