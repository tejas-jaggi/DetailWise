# Copy this file to .env and fill in real values. Never commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: local AI explanations through Ollama. No API key is needed.
# Leave these commented out to use the defaults shown.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3
# GUIDANCE_LLM_TIMEOUT=45
