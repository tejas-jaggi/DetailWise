# Secrets and local environment
.env
.env.*
!.env.example
.venv/
venv/

# Local database and generated files
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm
# Any other local or temporary database file (the project ships none)
*.sqlite3
*.db
staticfiles/
media/

# Python caches and test output
__pycache__/
*.py[cod]
.coverage
htmlcov/

# Course documents and spreadsheets never belong in this repository
*.pdf
*.xlsx
*.xls
*.docx

# Model weights (never commit these; Ollama stores its models outside the project)
*.bin
*.safetensors
*.pt
*.pth
*.gguf
*.onnx

# Task 10 evaluation results (written by `manage.py guidance_evaluate --live`;
# summarize chosen results in docs/task10_evaluation.md instead of committing raw files)
eval_results/

# Local tool state, logs and archives (not application code)
.impeccable/
.playwright-mcp/
*.log
*.zip

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
